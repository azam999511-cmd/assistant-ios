{
  "name": "murattib-assistant",
  "version": "2.3.0",
  "description": "مساعدي الشخصي",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.murattib.assistant",
    "productName": "مساعدي",
    "icon": "icon.ico",
    "artifactName": "Musaedi-${version}-${target}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "مساعدي"
    },
    "files": [
      "main.js",
      "preload.js",
      "calc.js",
      "index.html",
      "style.css",
      "renderer.js",
      "icon.ico",
      "sync.js",
      "server.js",
      "web-api.js",
      "sw.js",
      "manifest.webmanifest",
      "icon-192.png",
      "icon-512.png"
    ]
  }
}